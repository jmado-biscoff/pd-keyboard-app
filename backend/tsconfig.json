{
  "compilerOptions": {
    /* Output and Module System */
    "target": "es2020",
    "module": "commonjs",
    "rootDir": "./",
    "outDir": "./dist",

    /* TypeScript Settings */
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Optional Debugging */
    "sourceMap": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
